# Origen de solo lectura (MySQL de Senecode)
SOURCE_DB_URL=mysql://usuario:clave@adm-vm:3306/calificador?connect_timeout=5

# Base nueva (Postgres, docker compose)
LOCAL_DB_URL=postgres://llm:llm@localhost:5433/calificador_llm

# Token compartido con los nodos
API_TOKEN=cambia-este-token

# Ruteo opcional: metrica -> modelo (JSON). Vacío = todas las métricas a todos
# los modelos habilitados en la tabla `modelo`.
METRICAS_MODELO={}

LEASE_SECONDS=900
MAX_ATTEMPTS=3

# La ingesta arranca apagada; activar con SYNC_ENABLED=true
SYNC_ENABLED=false
SYNC_INTERVAL_S=30
SYNC_BATCH=500
SYNC_FROM_ID=0

HOST=0.0.0.0
PORT=8080

AUTO_REASIGNAR=true
MANTENER_MODELO_SIN_TRABAJO=false

HEARTBEAT_TIMEOUT_S=60

BATCH_POR_MODELO=true
